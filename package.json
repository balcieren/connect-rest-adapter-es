{
  "name": "connect-rest-adapter",
  "version": "0.2.5",
  "description": "Buf plugin that generates a REST adapter for Connect-RPC clients, rewriting URLs using google.api.http annotations",
  "author": "Eren Balci",
  "license": "MIT",
  "main": "dist/main.js",
  "bin": {
    "protoc-gen-connect-rest-adapter-es": "dist/main.js",
    "connect-rest-adapter": "dist/main.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "typecheck": "tsc --noEmit -p test",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "babel-jest": "^30.5.2",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "buf",
    "protobuf",
    "connect-rpc",
    "grpc",
    "http",
    "rest",
    "adapter",
    "fetch",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/balcieren/connect-rest-adapter-es"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@bufbuild/protoplugin": "^2.17.0"
  }
}
